# Production Environment Variables for Cloud Run
# 실제 배포 전에 이 값들을 업데이트하세요

# Application
ENV=production
DEBUG=false

# Model Backend
MODEL_BACKEND=ollama
OLLAMA_URL=http://your-ollama-server:11434

# Google Cloud
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# OpenAI (선택사항)
# OPENAI_API_KEY=your-openai-api-key

# SpeechPro (선택사항)
# SPEECHPRO_API_KEY=your-speechpro-api-key
# SPEECHPRO_API_URL=https://api.speechpro.com

# Database (Cloud SQL 사용 시)
# DATABASE_URL=postgresql://user:password@/dbname?host=/cloudsql/project:region:instance

# Security
SECRET_KEY=change-this-to-a-random-secret-key
ALLOWED_HOSTS=*

# CORS
CORS_ORIGINS=https://your-domain.com

# Storage
STORAGE_BUCKET=gs://your-bucket-name

# Monitoring
LOG_LEVEL=INFO
